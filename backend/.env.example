# HargaRadar backend configuration. Copy to ".env" and adjust.

# HTTP server
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info

# Inbound rate limit (requests per window, per IP)
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute

# Cache TTL in seconds. Scraping is slow and risky, so cache aggressively.
CACHE_TTL_SECONDS=300
CACHE_DIR=.cache

# ---------------------------------------------------------------------------
# Source toggles. Default: only the reliable used-phone sources are on.
# Turn on the experimental ones manually when you are ready (see README).
# ---------------------------------------------------------------------------
SOURCE_OLX=on
SOURCE_CAROUSELL=on
SOURCE_FACEBOOK=off
SOURCE_TOKOPEDIA=off
SOURCE_SHOPEE=off

# How many listings to keep per source per run (keep low to stay polite).
MAX_LISTINGS_PER_SOURCE=40

# ---------------------------------------------------------------------------
# Playwright / scraping
# ---------------------------------------------------------------------------
# Run browsers headless (true) or visible (false). fb-login always runs headful.
HEADLESS=true
# Per-source navigation timeout (ms).
NAV_TIMEOUT_MS=25000
# Optional: point to a specific Chromium binary. Leave empty to use the one
# installed by "npx playwright install chromium".
PLAYWRIGHT_EXECUTABLE_PATH=

# Debug scraping: when on, every scrape saves a screenshot + page HTML into
# DEBUG_DIR so you can see why a source returned nothing (block/captcha/empty/
# changed markup). Leave off in normal use. Zero-result runs are always
# explained in the logs regardless of this flag.
DEBUG_SCRAPE=off
DEBUG_DIR=debug

# Where the Facebook logged-in session is stored (persistent context).
FB_USER_DATA_DIR=.fb-userdata
# Facebook Marketplace needs a location. Set the city you want to search.
FB_LOCATION=jakarta
